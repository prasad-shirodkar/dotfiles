#!/usr/bin/env bash

function exists() {
  command -v "$1" &> /dev/null
}

function is_macos() {
  local platform
  platform=$(uname)
  [ "$platform" == "Darwin" ]
}

function is_linux() {
  local platform
  platform=$(uname)
  [ "$platform" == "Linux" ]
}

function is_cpu() {
  if [ -z "$1" ]; then
    echo "cpu manufacturer argument missing"
    return 1
  fi
  lscpu | grep "^Vendor ID:[ a-zA-Z]*$1" &> /dev/null
}

function is_cpu_intel() {
  is_cpu "Intel"
}

function docker_login() {
  if [ ! -r $HOME/.dockerhub_token.txt ]; then
    echo "docker token file not found"
    return 1
  fi
  cat $HOME/.dockerhub_token.txt | docker login --username pshirodkar --password-stdin
  if [ $? -ne 0 ]; then
    echo "docker login failed"
    return 1
  fi
}

function enable_docker_service() {
  sudo systemctl enable docker.service
  sudo systemctl enable containerd.service
  sudo systemctl status docker.service
  sudo systemctl status containerd.service
}

function disable_docker_service() {
  sudo systemctl disable docker.service
  sudo systemctl disable containerd.service
  sudo systemctl status docker.service
  sudo systemctl status containerd.service
}

function start_docker_service() {
  sudo systemctl start docker.service
  sudo systemctl start containerd.service
  sudo systemctl status docker.service
  sudo systemctl status containerd.service
}

function stop_docker_service() {
  sudo systemctl stop docker.service
  sudo systemctl stop containerd.service
  sudo systemctl status docker.service
  sudo systemctl status containerd.service
}

function docker_image_size() {
  docker inspect -f "{{ .Size }}" "$1" | numfmt --to=si
}

function delete_docker_images() {
 docker rmi $(docker images | grep "$1") -f
}

function delete_docker_images_dangling() {
 docker rmi $(docker images -f "dangling=true" -q)
}

function delete_docker_images_without_tag(){
 docker rmi $(docker images -a|grep "<none>"|awk '$1=="<none>" {print $3}')
}

# in your .bashrc/.zshrc/*rc
alias bathelp='bat --plain --language=help'
helpp() {
    "$@" --help 2>&1 | bathelp
}

# github starts here

function cloneAllGithubOrg() {
  if [[ -z "$GITHUB_ORG" ]]; then
    echo "error: GITHUB_ORG env var must be defined"
    return 1
  fi
  if [[ -z "$GITHUB_TOKEN" ]]; then
    echo "error: GITHUB_TOKEN env var must be defined"
    return 1
  fi
  # https://gist.github.com/caniszczyk/3856584?permalink_comment_id=3883313#gistcomment-3883313
  page=1
  while links=($(curl -H "Authorization: token ${GITHUB_TOKEN}" -s "https://api.github.com/orgs/${GITHUB_ORG}/repos?per_page=100&page=${page}" | jq -rc '.[] | {ssh_url} | .ssh_url'));  [[ "$links" ]]
  do
      GIT_TERMINAL_PROMPT=0 parallel git clone {} ::: "${links[@]}"
      ((++page))
  done
}

function github_prs_requesting_my_review() {
  gh search prs --review-requested=@me --state=open
}

# github ends here

#mac internet troubleshooting
function airport_loop() {
 if ! is_macos; then
  echo "This is not macos"
  exit 1
 fi
 while sleep 1; do
  #airport -I | grep 'agrCtlRSSI'
  airport -I
  printf "\n"
 done
}
alias wifitest="airport_loop"

function toggle_mac_dock() {
 if ! is_macos; then
  echo "This is not macos"
  exit 1
 fi
 local curr=$(defaults read com.apple.Dock autohide)
 if [[ $curr -eq 0 ]]; then
   defaults write com.apple.dock autohide -bool true; killall Dock
 else
   defaults write com.apple.dock autohide -bool false; killall Dock
 fi
}

function markdown_preview() {
  find . \( -path '*/vendor/*' -or -path '*/.git/*' -or -path '*/node_modules/*' \) -prune -or -type f -name "*.md" -print | fzf | xargs lnav
}

function markdown() {
  pandoc "$1" | lynx -stdin
}

function markdown_browser_preview() {
  pandoc "$1" > ~/tmp/"$1".html
  if is_linux; then
    xdg-open ~/tmp/"$1".html
  elif is_macos; then
    open ~/tmp/"$1".html
  fi
}

# find markdown files recursively and preview
function find_md() {
  fd '.md$' | xargs -I _ -- bat --paging=always _
}

# https://pagure.io/setup/blob/master/f/profile
pathmunge () {
    case ":${PATH}:" in
        *:"$1":*)
            ;;
        *)
            if [ "$2" = "after" ] ; then
                PATH=$PATH:$1
            else
                PATH=$1:$PATH
            fi
    esac
}

function git_branch_delete() {
  if [ -n $1 ]; then
    git branch -D $1 && git push origin --delete $1
  elif [ -n $1 && -n $2 ]; then
    git branch -D $1 && git push $2 --delete $1
  else
    echo "branch name argument missing"
  fi
}

function git_clean_repository() {
  git clean -fdx; git submodule foreach git clean -fdx
}

# repository register recursive using mr - a Multiple Repository management tool
function repository_register_recursive() {
  find . -mindepth 1 -maxdepth 1 -type d -print -exec bash -c 'cd "$0"; mr register; cd ..' {} \;
}

# repository fetch recursive using mr - a Multiple Repository management tool
function repository_fetch_recursive() {
  mr -j5 fetch --force --tags
}

# repository update recursive using mr - a Multiple Repository management tool
function repository_update_recursive() {
  #find . -mindepth 1 -maxdepth 1 -type d -print -exec bash -c 'cd "$0"; mr -j5 update; cd ..' {} \;
  mr -j5 update
}

# go mod download using mr - a Multiple Repository management tool
function go_mod_download_recursive() {
  find . -mindepth 1 -maxdepth 1 -type d -print -exec bash -c 'cd "$0"; go mod download; cd ..' {} \;
}

function mcd() {
  mkdir -p "$1" && cd "$1"
}

function install_via_apt() {
  if exists apt; then
    sudo apt modernize-sources

    if ! grep -q "^Components:[[:space:]].*contrib non-free non-free-firmware" debian.sources; then 
      sudo sed -i '/^Components:/ s/$/ contrib non-free non-free-firmware/' /etc/apt/sources.list.d/debian.sources
    fi

    sudo apt update && sudo apt full-upgrade -y && sudo apt install -y apt-file curl wget vim-gtk3 xsel \
    stow tldr fzf shellcheck chromium chrome-gnome-shell golang tig jq yq ripgrep fd-find htop tree wireguard xclip \
    openvpn nmap file awscli pandoc lynx info autojump neofetch git gitk tmux gnome-tweaks gparted keepassxc ncdu bat fd-find fonts-indic \
    hardinfo ansible vagrant ncdu dmidecode whois ldnsutils bat firmware-linux firmware-linux-nonfree firmware-misc-nonfree firmware-realtek ufw hdparm yt-dlp \
    debian-refcard doc-base bridge-utils wireguard openresolv myrepos extrepo tokei make-doc rustup pdfgrep sioyek lshw
  fi

  install_intel_packages
  install_laptop_packages
  install_glow
  install_rupa_z
  install_kubectl
  install_helm
  install_docker
  install_kind
  install_sublimetext
  install_google_chrome
  install_rust_cargo_packages
}

function install_docker() {
  # https://docs.docker.com/engine/install/debian/#install-using-the-repository
  if exists apt; then
    # Add Docker's official GPG key:
    sudo apt-get update
    sudo apt-get install ca-certificates curl
    sudo install -m 0755 -d /etc/apt/keyrings
    sudo curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
    sudo chmod a+r /etc/apt/keyrings/docker.asc

    # Add the repository to Apt sources:
    echo \
      "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian \
      $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | \
      sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
    sudo apt-get update
    sudo apt-get install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  fi
}

function install_laptop_packages() {
  laptop-detect --verbose &> /dev/null
  if [ $? -eq 0 ]; then
    exists apt && sudo apt install tlp tlp-rdw tp-smapi-dkms smartmontools
  else
    print "error: not a laptop"
    return 1
  fi
}
function install_intel_packages() {
  is_cpu_intel && exists apt && sudo apt install -y firmware-intel-graphics firmware-intel-misc firmware-mediatek intel-microcode \
	  firmware-iwlwifi firmware-ipw2x00 firmware-intel-graphics firmware-intel-sound
}

function install_glow() {
  # https://github.com/charmbracelet/glow
  if exists apt; then
    sudo mkdir -p -m 755 /etc/apt/keyrings
    if [ ! -f "/etc/apt/keyrings/charm.gpg" ]; then
      curl -fsSL https://repo.charm.sh/apt/gpg.key | sudo gpg --dearmor -o /etc/apt/keyrings/charm.gpg
      echo "deb [signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *" | sudo tee /etc/apt/sources.list.d/charm.list
    fi
    sudo apt update && sudo apt install -y glow
  fi
}

function install_kubectl() {
  # https://kubernetes.io/docs/tasks/tools/install-kubectl-linux/#install-using-native-package-management
  if exists apt; then
    sudo apt-get update
    # apt-transport-https may be a dummy package; if so, you can skip that package
    sudo apt-get install -y apt-transport-https ca-certificates curl
    sudo mkdir -p -m 755 /etc/apt/keyrings
    if [ ! -f "/etc/apt/keyrings/kubernetes-apt-keyring.gpg" ]; then
      local version="v1.35"
      curl -fsSL https://pkgs.k8s.io/core:/stable:/$version/deb/Release.key | sudo gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
      echo 'deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/$version/deb/ /' | sudo tee /etc/apt/sources.list.d/kubernetes.list
      sudo chmod 644 /etc/apt/sources.list.d/kubernetes.list   # helps tools such as command-not-found to work correctly
    fi
    sudo apt update && sudo apt install -y kubectl
  fi
}

function install_helm() {
  # https://helm.sh/docs/intro/install/#from-apt-debianubuntu
  if exists apt; then
    sudo apt-get install curl gpg apt-transport-https --yes
    curl -fsSL https://packages.buildkite.com/helm-linux/helm-debian/gpgkey | gpg --dearmor | sudo tee /usr/share/keyrings/helm.gpg > /dev/null
    echo "deb [signed-by=/usr/share/keyrings/helm.gpg] https://packages.buildkite.com/helm-linux/helm-debian/any/ any main" | sudo tee /etc/apt/sources.list.d/helm-stable-debian.list
    sudo apt-get update
    sudo apt-get install helm
  fi
}

function install_rupa_z() {
  if is_linux; then
    git clone https://github.com/rupa/z/ ~/tmp/z
    chmod +x ~/tmp/z/z.sh
    sudo mv ~/tmp/z/z.sh /usr/local/bin/
    sudo mkdir -p /usr/local/share/man/man1
    sudo mv ~/tmp/z/z.1 /usr/local/share/man/man1/
    rm -rf ~/tmp/z
  fi
}

function install_kind() {
  # https://kind.sigs.k8s.io/docs/user/quick-start#installing-from-release-binaries
  if is_linux; then
    # For AMD64 / x86_64
    [ $(uname -m) = x86_64 ] && curl -Lo ./kind https://kind.sigs.k8s.io/dl/v0.24.0/kind-linux-amd64
    # For ARM64
    [ $(uname -m) = aarch64 ] && curl -Lo ./kind https://kind.sigs.k8s.io/dl/v0.24.0/kind-linux-arm64
    chmod +x ./kind
    sudo mv ./kind /usr/local/bin/kind
  fi
}

function install_sublimetext() {
  # https://www.sublimetext.com/docs/linux_repositories.html
  if exists apt; then
    wget -qO - https://download.sublimetext.com/sublimehq-pub.gpg | gpg --dearmor | sudo tee /etc/apt/trusted.gpg.d/sublimehq-archive.gpg > /dev/null
    echo "deb https://download.sublimetext.com/ apt/stable/" | sudo tee /etc/apt/sources.list.d/sublime-text.list
    sudo apt-get update
    sudo apt-get install sublime-text
  fi
}

function install_google_chrome() {
  if exists apt; then
    curl -fSsL https://dl.google.com/linux/linux_signing_key.pub | sudo gpg --dearmor | sudo tee /usr/share/keyrings/google-chrome.gpg >> /dev/null
    echo deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main | sudo tee /etc/apt/sources.list.d/google-chrome.list
    sudo apt-get update
    sudo apt install google-chrome-stable
  fi
}

function install_rust_cargo_packages() {
  if exists cargo; then
    cargo install difftastic
  fi
}

function update() {
  if is_linux; then
    if exists apt; then
      print_execute sudo apt-get update;
      print_execute sudo apt-get upgrade;
      print_execute sudo apt-get autoremove --purge;
      print_execute sudo apt-get clean;
    elif exists dnf; then
      print_execute sudo dnf upgrade;
      print_execute sudo dnf autoremove;
      print_execute sudo dnf clean all;
      print_execute sudo dnf needs-restarting -rus;
    fi
  elif is_macos; then
    if exists brew; then
      print_execute brew update;
      print_execute brew upgrade;
      print_execute brew upgrade --cask --force --greedy;
      print_execute brew cleanup --prune=all;
    fi
  fi
}

# Top k largest files in current directory recursive
function duh() {
  local num="${1:-10}"
  du -ah . | sort -hr | head -n $num
}

function extract_rpm() {
  rpm2cpio "$1" | cpio -idmv
}

function field() {
  awk '{print $'"$1"'}'
}

function print_execute() {
  printf "+ %s\n" "$*" 2>&1
  "$@"
}

function ufw_execute() {
  sudo ufw status &> /dev/null
  if [ $? -ne 0 ]; then
    print "error: ufw not installed"
    return 1
  fi
  sudo ufw allow ssh
  sudo ufw default deny incoming
  sudo ufw default allow outgoing

  sudo ufw enable
}

function extract_audio() {
  if [ -z "$1" ]; then
    print "argument missing"
    return 1
  fi
  yt-dlp --embed-metadata --embed-thumbnail --extract-audio --audio-format best --audio-quality 0 --output '%(title)s.%(ext)s' "$1"
}

#oci starts here
oci_delete_load_balancers() {
  oci lb load-balancer list --all | jq '.data[].id' -r | while read vocid; do echo "Deleting $vocid" && oci lb load-balancer delete --force --load-balancer-id $vocid; done
}

oci_delete_network_load_balancers() {
  oci nlb network-load-balancer list --all | jq '.data.items[].id' -r | while read vocid; do echo "Deleting $vocid" && oci nlb network-load-balancer delete --force --network-load-balancer-id $vocid; done
}

oci_delete_block_volumes() {
  oci bv volume list --all | jq '.data[].id' -r | while read vocid; do echo "Deleting $vocid" && oci bv volume delete --force --volume-id $vocid; done
}

oci_delete_boot_volumes() {
  oci bv boot-volume list --all | jq '.data[].id' -r | while read vocid; do echo "Deleting $vocid" && oci bv boot-volume delete --force --boot-volume-id $vocid; done
}

oci_delete_oke_clusters() {
  oci ce cluster list --all | jq '.data[].id' -r | while read vocid; do echo "Deleting $vocid" && oci ce cluster delete --force --cluster-id $vocid; done
}

oci_delete_compute_instances() {
  oci compute instance list --all | jq '.data[].id' -r | while read vocid; do echo "Deleting $vocid" && oci compute instance terminate --force --instance-id $vocid; done
}

delete_oci_cruft() {
  oci_delete_oke_clusters
  oci_delete_compute_instances
  oci_delete_load_balancers
  oci_delete_network_load_balancers
  oci_delete_block_volumes
  oci_delete_boot_volumes
}
#oci ends here

unset_proxy() {
  unset ALL_PROXY HTTPS_PROXY HTTP_PROXY http_proxy https_proxy no_proxy NO_PROXY
}

SSH_CONFIG_FILE="$HOME/.ssh/config"
#PROXY_COMMAND="nc -X connect -x $PROXY_JUMP_HOST %h %p"
#PROXY_COMMAND="ssh -W %h:%p $PROXY_JUMP_HOST"

function set_ssh_proxy_command() {
    if [[ "$#" -ne 2 ]]; then
      echo "error: ssh host alias or proxy jump host missing" 2>&1
      return 1
    fi
    local host_alias="$1"
    local proxy_jump_host="$2"
    local proxy_command="nc -X connect -x $proxy_jump_host %h %p"
    if grep -q "Host $host_alias" "$SSH_CONFIG_FILE"; then
      gsed -i '/Host '"$host_alias"'/,/Host / {
	  /ProxyCommand/ {
	    s/.*/  ProxyCommand '"$proxy_command"'/
	    h
	  }
	  $!b; /ProxyCommand/! a\  ProxyCommand '"$proxy_command"'
	}' "$SSH_CONFIG_FILE"
    fi
}

function unset_ssh_proxy_command() {
    if [[ "$#" -ne 1 ]]; then
      echo "error: ssh host alias missing" 2>&1
      return 1
    fi
    local host_alias="$1"
    gsed -i "/Host $host_alias/,/Host / { /ProxyCommand/d }" "$SSH_CONFIG_FILE"
}

# Refer https://smallsharpsoftwaretools.com/tutorials/read_a_line_from_a_file/
function catln() {
  num=$1
  input=$2
  if [ -z "$input" ]; then
    sed -n ${num}p </dev/stdin
  else
    sed -n ${num}p $input
  fi
}

function image_registry_login() {
  if [[ "$#" -ne 4 ]]; then
    echo "error: expected 4 arguments, got $# arguments instead" 2>&1
    return 1
  fi
  cat "$1" | "$2" login "$3" --username "$4" --password-stdin
}
