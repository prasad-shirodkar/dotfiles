#!/usr/bin/env bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
source $SCRIPT_DIR/.functions

pushd $SCRIPT_DIR > /dev/null

if exists brew; then
  # https://docs.brew.sh/Manpage#shellenv-bashcshfishpwshshtcshzsh
  eval "$(brew shellenv)"

  HOMEBREW_PREFIX=$(brew --prefix)

  # most programs
  pathmunge ${HOMEBREW_PREFIX}/bin
  export MANPATH="${HOMEBREW_PREFIX}/share/man:$MANPATH"
  export INFOPATH="${HOMEBREW_PREFIX}/share/info:$INFOPATH"

  # coreutils
  pathmunge ${HOMEBREW_PREFIX}/opt/coreutils/libexec/gnubin
  export MANPATH="${HOMEBREW_PREFIX}/opt/coreutils/libexec/gnuman:$MANPATH"

  # gnu-sed
  pathmunge ${HOMEBREW_PREFIX}/opt/gnu-sed/libexec/gnubin
  export MANPATH="${HOMEBREW_PREFIX}/opt/gnu-sed/libexec/gnuman:$MANPATH"

  # gnu-tar
  pathmunge ${HOMEBREW_PREFIX}/opt/gnu-tar/libexec/gnubin
  export MANPATH="${HOMEBREW_PREFIX}/opt/gnu-tar/libexec/gnuman:$MANPATH"
  
  # gnu make
  pathmunge ${HOMEBREW_PREFIX}/opt/make/libexec/gnubin
  export MANPATH="${HOMEBREW_PREFIX}/opt/make/libexec/gnuman:$MANPATH"

  # gnu findutils
  pathmunge ${HOMEBREW_PREFIX}/opt/findutils/libexec/gnubin
  export MANPATH="${HOMEBREW_PREFIX}/opt/findutils/libexec/gnuman:$MANPATH"

  # gnu diffutils
  pathmunge ${HOMEBREW_PREFIX}/opt/diffutils/libexec/gnubin
  export MANPATH="${HOMEBREW_PREFIX}/opt/diffutils/libexec/gnuman:$MANPATH"
fi

if [[ -d "/usr/local/opt/groovy/libexec" ]]; then
  export GROOVY_HOME="/usr/local/opt/groovy/libexec"
  pathmunge $GROOVY_HOME/bin
fi

# On debian, fd-find package contains fdfind instead. So create "fd" symlink for fdfind
if is_linux && [[ ! -f $HOME/.local/bin/fd ]] && exists fdfind; then
  mkdir -p $HOME/.local/bin
  ln -s $(which fdfind) $HOME/.local/bin/fd
  pathmunge $HOME/.local/bin
fi

# On debian, bat package contains batcat instead. So create "bat" symlink for batcat
if is_linux && [[ ! -f $HOME/.local/bin/bat ]] && exists batcat; then
  mkdir -p $HOME/.local/bin
  ln -s $(which batcat) $HOME/.local/bin/bat
  pathmunge $HOME/.local/bin
fi

popd > /dev/null
